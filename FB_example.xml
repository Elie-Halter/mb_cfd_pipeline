<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="1.0">
<!-- ===========================================================================
  Rigid-wall (FB) example: the production configuration of the companion paper.

  The reference arm of the FB-versus-MB comparison. It shares the mesh, inflow, outlet
  boundary conditions, time step and output cadence with MB_example.xml; the differences are the
  rigid no-slip wall (Dirichlet 0), the absence of the mesh equation, and the smaller nonlinear
  iteration limit and NS linear-solver limits of the production FB run. Paths are relative to
  the run directory:
    mesh/mesh-complete.mesh.vtu, mesh/mesh-surfaces/*.vtp   all-tet mesh in mm, GlobalNodeID
    inflow.txt   inlet flow rate, NEGATIVE for an inflow (tools/make_inlet_flow.py,
                 CONVENTIONS.md sections 1-2)
  tools/make_patient_xml.py repoints the paths and the number of steps for a case.
=========================================================================== -->

<GeneralSimulationParameters>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <!-- 4 cycles of ~0.974 s at dt = 1 ms; the analysis uses the last cycle -->
  <Number_of_time_steps> 3896 </Number_of_time_steps>
  <Time_step_size> 0.001 </Time_step_size>
  <Restart_file_name> results </Restart_file_name>
  <Increment_in_saving_restart_files> 10 </Increment_in_saving_restart_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>
  <Continue_previous_simulation> false </Continue_previous_simulation>
  <Save_averaged_results> true </Save_averaged_results>
  <Save_results_to_VTK_format> true </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> results </Name_prefix_of_saved_VTK_files>
  <!-- one result file every 10 ms, the same cadence in FB and MB (TAWSS/OSI sampling) -->
  <Increment_in_saving_VTK_files> 10 </Increment_in_saving_VTK_files>
  <!-- generalized-alpha high-frequency damping (rho_inf = 0.2, below the default) -->
  <Spectral_radius_of_infinite_time_step> 0.2 </Spectral_radius_of_infinite_time_step>
  <!-- touch STOP_SIM in the run directory to stop cleanly at the next step -->
  <Searched_file_name_to_trigger_stop>STOP_SIM</Searched_file_name_to_trigger_stop>
  <Verbose> true </Verbose>
  <Warning> true </Warning>
  <Debug> false </Debug>
</GeneralSimulationParameters>

<Add_mesh name="lumen">
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>
  <!-- mesh in mm, solver in cm -->
  <Mesh_scale_factor> 0.1 </Mesh_scale_factor>
  <Add_face name="asc">
    <Face_file_path> mesh/mesh-surfaces/asc.vtp </Face_file_path>
  </Add_face>
  <Add_face name="desc">
    <Face_file_path> mesh/mesh-surfaces/desc.vtp </Face_file_path>
  </Add_face>
  <Add_face name="btca">
    <Face_file_path> mesh/mesh-surfaces/btca.vtp </Face_file_path>
  </Add_face>
  <Add_face name="lcca">
    <Face_file_path> mesh/mesh-surfaces/lcca.vtp </Face_file_path>
  </Add_face>
  <Add_face name="lsa">
    <Face_file_path> mesh/mesh-surfaces/lsa.vtp </Face_file_path>
  </Add_face>
  <Add_face name="wall">
    <Face_file_path> mesh/mesh-surfaces/wall.vtp </Face_file_path>
  </Add_face>
</Add_mesh>

<Add_equation type="fluid">
  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <!-- up to 8 nonlinear iterations (the MB run allows 15) -->
  <Max_iterations> 8 </Max_iterations>
  <Tolerance> 1e-3 </Tolerance>

  <!-- backflow stabilization at the outlets, 1.0 in both FB and MB -->
  <Backflow_stabilization_coefficient> 1.0 </Backflow_stabilization_coefficient>
  <!-- blood: g/cm^3 and poise (Newtonian) -->
  <Density> 1.06 </Density>
  <Viscosity model="Constant">
    <Value> 0.04 </Value>
  </Viscosity>
  <!-- NS linear solver (the MB run doubles the Krylov space and the iteration limits) -->
  <LS type="NS">
    <Max_iterations> 100 </Max_iterations>
    <Tolerance> 5e-3 </Tolerance>
    <Krylov_space_dimension> 100 </Krylov_space_dimension>
    <NS_GM_max_iterations> 3 </NS_GM_max_iterations>
    <NS_GM_tolerance> 1e-2 </NS_GM_tolerance>
    <NS_CG_max_iterations> 200 </NS_CG_max_iterations>
    <NS_CG_tolerance> 1e-2 </NS_CG_tolerance>
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
  </LS>
  <Output type="Spatial">
    <Velocity> true </Velocity>
    <Pressure> true </Pressure>
    <WSS> true </WSS>
    <!-- vorticity is written so that helicity (u . omega) can be computed in post-processing -->
    <Vorticity> true </Vorticity>
  </Output>
  <!-- inlet: flow-rate waveform, NEGATIVE for an inflow (the solver imposes v = Q * profile *
       n_out). Parabolic profile scaled to Q(t) by Impose_flux, as in MB_example.xml. -->
  <Add_BC name="asc">
    <Type> Dirichlet </Type>
    <Time_dependence> Unsteady </Time_dependence>
    <Temporal_values_file_path> inflow.txt </Temporal_values_file_path>
    <Profile> Parabolic </Profile>
    <Impose_flux> true </Impose_flux>
  </Add_BC>
  <!-- rigid wall: no-slip -->
  <Add_BC name="wall">
    <Type> Dirichlet </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0 </Value>
  </Add_BC>
  <!-- outlets: three-element Windkessel (RCR), units dyn s/cm^5 and cm^5/dyn.
       EXAMPLE VALUES: replace them with the output of tools/calibrate_rcr.py for your case.
       Initial_pressure (dyn/cm^2, here ~85 mmHg) starts the capacitors near the mean arterial
       pressure to shorten the start-up transient. -->
  <Add_BC name="desc">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 187.9 </Proximal_resistance>
      <Capacitance> 7.9801e-04 </Capacitance>
      <Distal_resistance> 1879.7 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
  <Add_BC name="lcca">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 3011.1 </Proximal_resistance>
      <Capacitance> 4.9809e-05 </Capacitance>
      <Distal_resistance> 30114.8 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
  <Add_BC name="btca">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 1123.2 </Proximal_resistance>
      <Capacitance> 1.3353e-04 </Capacitance>
      <Distal_resistance> 11233.3 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
  <Add_BC name="lsa">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 1887.0 </Proximal_resistance>
      <Capacitance> 7.9483e-05 </Capacitance>
      <Distal_resistance> 18871.9 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
