<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="1.0">
<!-- ===========================================================================
  Moving-boundary (MB) example: the production configuration of the companion paper.

  Solver, boundary-condition and linear-solver settings are those of the production MB run;
  only the paths are generic and relative to the run directory:
    mesh/mesh-complete.mesh.vtu, mesh/mesh-surfaces/*.vtp   all-tet mesh in mm, GlobalNodeID
    inflow.txt              inlet flow rate, NEGATIVE for an inflow (tools/make_inlet_flow.py,
                            CONVENTIONS.md sections 1-2)
    wall_displacement.txt   STANDARD wall-only displacement file (wall nodes only, positions in
                            cm; morph/run_pinned_morph.py + tools/extended_to_standard.py, or
                            chain_image/write_wall_displacement.py)
  The wall motion is prescribed on the wall face only; the caps are pinned (Dir 0 in the mesh
  equation) and the wall motion is tapered to zero over 12 mm next to them; the interior of the
  mesh is moved by the mesh equation at every step. The rigid-wall counterpart is FB_example.xml,
  identical except for the wall boundary condition and the absence of the mesh equation.
  tools/make_patient_xml.py repoints the paths and the number of steps for a case.
=========================================================================== -->

<GeneralSimulationParameters>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <!-- 4 cycles of ~0.974 s at dt = 1 ms; the analysis uses the last cycle -->
  <Number_of_time_steps> 3896 </Number_of_time_steps>
  <Time_step_size> 0.001 </Time_step_size>
  <Restart_file_name> results </Restart_file_name>
  <Increment_in_saving_restart_files> 10 </Increment_in_saving_restart_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>
  <Continue_previous_simulation> false </Continue_previous_simulation>
  <Save_averaged_results> true </Save_averaged_results>
  <Save_results_to_VTK_format> true </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> results </Name_prefix_of_saved_VTK_files>
  <!-- one result file every 10 ms, the same cadence in FB and MB (TAWSS/OSI sampling) -->
  <Increment_in_saving_VTK_files> 10 </Increment_in_saving_VTK_files>
  <!-- generalized-alpha high-frequency damping (rho_inf = 0.2, below the default) -->
  <Spectral_radius_of_infinite_time_step> 0.2 </Spectral_radius_of_infinite_time_step>
  <!-- touch STOP_SIM in the run directory to stop cleanly at the next step -->
  <Searched_file_name_to_trigger_stop>STOP_SIM</Searched_file_name_to_trigger_stop>
  <Verbose> true </Verbose>
  <Warning> true </Warning>
  <Debug> false </Debug>
</GeneralSimulationParameters>

<Add_mesh name="lumen">
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>
  <!-- mesh in mm, solver in cm -->
  <Mesh_scale_factor> 0.1 </Mesh_scale_factor>
  <Add_face name="asc">
    <Face_file_path> mesh/mesh-surfaces/asc.vtp </Face_file_path>
  </Add_face>
  <Add_face name="desc">
    <Face_file_path> mesh/mesh-surfaces/desc.vtp </Face_file_path>
  </Add_face>
  <Add_face name="btca">
    <Face_file_path> mesh/mesh-surfaces/btca.vtp </Face_file_path>
  </Add_face>
  <Add_face name="lcca">
    <Face_file_path> mesh/mesh-surfaces/lcca.vtp </Face_file_path>
  </Add_face>
  <Add_face name="lsa">
    <Face_file_path> mesh/mesh-surfaces/lsa.vtp </Face_file_path>
  </Add_face>
  <Add_face name="wall">
    <Face_file_path> mesh/mesh-surfaces/wall.vtp </Face_file_path>
  </Add_face>
</Add_mesh>

<Add_equation type="fluid">
  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <!-- up to 15 nonlinear iterations: the moving-wall run needs more than the rigid one at
       systole; most steps converge in 3-4 iterations -->
  <Max_iterations> 15 </Max_iterations>
  <Tolerance> 1e-3 </Tolerance>

  <!-- backflow stabilization at the outlets, 1.0 in both FB and MB -->
  <Backflow_stabilization_coefficient> 1.0 </Backflow_stabilization_coefficient>
  <!-- blood: g/cm^3 and poise (Newtonian) -->
  <Density> 1.06 </Density>
  <Viscosity model="Constant">
    <Value> 0.04 </Value>
  </Viscosity>
  <!-- NS linear solver: larger Krylov space and iteration limits than FB, needed at systole
       on the moving mesh -->
  <LS type="NS">
    <Max_iterations> 200 </Max_iterations>
    <Tolerance> 5e-3 </Tolerance>
    <Krylov_space_dimension> 200 </Krylov_space_dimension>
    <NS_GM_max_iterations> 6 </NS_GM_max_iterations>
    <NS_GM_tolerance> 1e-2 </NS_GM_tolerance>
    <NS_CG_max_iterations> 400 </NS_CG_max_iterations>
    <NS_CG_tolerance> 1e-2 </NS_CG_tolerance>
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
  </LS>
  <Output type="Spatial">
    <Velocity> true </Velocity>
    <Pressure> true </Pressure>
    <WSS> true </WSS>
    <!-- vorticity is written so that helicity (u . omega) can be computed in post-processing -->
    <Vorticity> true </Vorticity>
  </Output>
  <!-- inlet: flow-rate waveform, NEGATIVE for an inflow (the solver imposes v = Q * profile *
       n_out). Parabolic profile scaled to Q(t) by Impose_flux; it vanishes smoothly at the wall,
       which avoids the velocity jump a flat profile creates at the moving wall ring. -->
  <Add_BC name="asc">
    <Type> Dirichlet </Type>
    <Time_dependence> Unsteady </Time_dependence>
    <Temporal_values_file_path> inflow.txt </Temporal_values_file_path>
    <Profile> Parabolic </Profile>
    <Impose_flux> true </Impose_flux>
  </Add_BC>
  <!-- moving wall: fluid velocity = wall velocity (moving no-slip). Not Dirichlet 0, which would
       let the wall move without displacing fluid (CONVENTIONS.md section 3). -->
  <Add_BC name="wall">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> wall_displacement.txt </Prescribed_displacement_file_path>
    <Impose_on_state_variable_integral> true </Impose_on_state_variable_integral>
  </Add_BC>
  <!-- outlets: three-element Windkessel (RCR), units dyn s/cm^5 and cm^5/dyn.
       EXAMPLE VALUES: replace them with the output of tools/calibrate_rcr.py for your case.
       Initial_pressure (dyn/cm^2, here ~85 mmHg) starts the capacitors near the mean arterial
       pressure to shorten the start-up transient. -->
  <Add_BC name="desc">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 187.9 </Proximal_resistance>
      <Capacitance> 7.9801e-04 </Capacitance>
      <Distal_resistance> 1879.7 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
  <Add_BC name="lcca">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 3011.1 </Proximal_resistance>
      <Capacitance> 4.9809e-05 </Capacitance>
      <Distal_resistance> 30114.8 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
  <Add_BC name="btca">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 1123.2 </Proximal_resistance>
      <Capacitance> 1.3353e-04 </Capacitance>
      <Distal_resistance> 11233.3 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
  <Add_BC name="lsa">
    <Type> Neumann </Type>
    <Time_dependence> RCR </Time_dependence>
    <RCR_values>
      <Proximal_resistance> 1887.0 </Proximal_resistance>
      <Capacitance> 7.9483e-05 </Capacitance>
      <Distal_resistance> 18871.9 </Distal_resistance>
      <Distal_pressure> 0 </Distal_pressure>
      <Initial_pressure> 113000 </Initial_pressure>
    </RCR_values>
  </Add_BC>
</Add_equation>

<Add_equation type="mesh">
  <!-- Jacobian-based stiffening of small/distorted elements (patches 0004-0009); nearly uniform
       at Mesh_scale_factor 0.1, see patches/svMP/README.md -->
  <Mesh_stiffness_exponent> 2.0 </Mesh_stiffness_exponent>

  <Coupled> true </Coupled>
  <!-- the mesh equation is linear elasticity: one solve per time step -->
  <Min_iterations> 1 </Min_iterations>
  <Max_iterations> 1 </Max_iterations>
  <Tolerance> 0.1 </Tolerance>
  <Poisson_ratio> 0.30 </Poisson_ratio>
  <!-- FSILS GMRES. The alternative used for the other production case is
       <Linear_algebra type="petsc"> with the GAMG preconditioner, selected through
       PETSC_OPTIONS="-pc_type gamg -pc_gamg_type agg" (exported by run_MB_aniso.sh and
       tools/svmp_run.sh); the XML Preconditioner value is then overridden. -->
  <LS type="GMRES">
    <Max_iterations> 500 </Max_iterations>
    <Tolerance> 5e-3 </Tolerance>
    <Krylov_space_dimension> 300 </Krylov_space_dimension>
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
  </LS>
  <Output type="Spatial">
    <Displacement> true </Displacement>
  </Output>
  <!-- caps pinned: the caps do not move, which the closed-boundary mass balance relies on; the
       wall motion is tapered to zero over 12 mm from the cap rings (CONVENTIONS.md section 4) -->
  <Add_BC name="asc">
    <Type> Dir </Type>
    <Value> 0.0 </Value>
  </Add_BC>
  <Add_BC name="desc">
    <Type> Dir </Type>
    <Value> 0.0 </Value>
  </Add_BC>
  <Add_BC name="btca">
    <Type> Dir </Type>
    <Value> 0.0 </Value>
  </Add_BC>
  <Add_BC name="lcca">
    <Type> Dir </Type>
    <Value> 0.0 </Value>
  </Add_BC>
  <Add_BC name="lsa">
    <Type> Dir </Type>
    <Value> 0.0 </Value>
  </Add_BC>
  <!-- wall: positions from the STANDARD wall-only file; the interior follows the mesh equation -->
  <Add_BC name="wall">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> wall_displacement.txt </Prescribed_displacement_file_path>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
