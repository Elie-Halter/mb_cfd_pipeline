<svMultiPhysicsFile version="1.0">

<!-- ============================================================
  B1 - FREE-STREAM PRESERVATION ON A MOVING MESH (template; @CASE@ is filled in by
  benchmarks/run_all.sh with the directory written by gen_case.py).
  Exact solution of the ALE Navier-Stokes equations: u = (10,0,0) cm/s, uniform p, for ANY
  mesh motion. Motion: affine dilation s(t) = 1 + 0.04 (1 - cos 2 pi t), ~26 % volume swing,
  prescribed on the six faces through the mesh equation; interior = mesh equation.
  Metric (analyze.py): max over nodes of |u - U|/U at every step, and L2(div u).
============================================================ -->

<GeneralSimulationParameters>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 200 </Number_of_time_steps>   <!-- one period at dt = 5 ms -->
  <Time_step_size> 0.005 </Time_step_size>
  <Restart_file_name> results </Restart_file_name>
  <Increment_in_saving_restart_files> 100 </Increment_in_saving_restart_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>
  <Continue_previous_simulation> false </Continue_previous_simulation>
  <Simulation_initialization_file_path> @CASE@/ic_uniform.vtu </Simulation_initialization_file_path>
  <Save_averaged_results> false </Save_averaged_results>
  <Save_results_to_VTK_format> true </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> results </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>  <!-- the metric is evaluated at every step -->
  <Spectral_radius_of_infinite_time_step> 0.2 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>
  <Verbose> true </Verbose>
  <Warning> true </Warning>
  <Debug> false </Debug>
</GeneralSimulationParameters>

<Add_mesh name="box">
  <Mesh_file_path> @CASE@/mesh/mesh-complete.mesh.vtu </Mesh_file_path>
  <Mesh_scale_factor> 0.1 </Mesh_scale_factor>   <!-- mm -> cm (pipeline convention) -->
  <Add_face name="x0">
    <Face_file_path> @CASE@/mesh/mesh-surfaces/x0.vtp </Face_file_path>
  </Add_face>
  <Add_face name="x1">
    <Face_file_path> @CASE@/mesh/mesh-surfaces/x1.vtp </Face_file_path>
  </Add_face>
  <Add_face name="y0">
    <Face_file_path> @CASE@/mesh/mesh-surfaces/y0.vtp </Face_file_path>
  </Add_face>
  <Add_face name="y1">
    <Face_file_path> @CASE@/mesh/mesh-surfaces/y1.vtp </Face_file_path>
  </Add_face>
  <Add_face name="z0">
    <Face_file_path> @CASE@/mesh/mesh-surfaces/z0.vtp </Face_file_path>
  </Add_face>
  <Add_face name="z1">
    <Face_file_path> @CASE@/mesh/mesh-surfaces/z1.vtp </Face_file_path>
  </Add_face>
</Add_mesh>

<Add_equation type="fluid">
  <Coupled> true </Coupled>
  <Min_iterations> 2 </Min_iterations>
  <Max_iterations> 10 </Max_iterations>
  <Tolerance> 1e-3 </Tolerance>   <!-- production tolerances: tightening them (LS 1e-6 or
       non-linear 1e-9) makes the FSILS NS solve singular on the pressure mode under mesh motion;
       the free stream is therefore preserved to the iterative-solver floor (~1e-7 per step). -->

  <Backflow_stabilization_coefficient> 0.2 </Backflow_stabilization_coefficient>
  <Density> 1.06 </Density>
  <Viscosity model="Constant">
    <Value> 0.04 </Value>
  </Viscosity>
  <LS type="NS">
    <Max_iterations> 200 </Max_iterations>
    <Tolerance> 5e-3 </Tolerance>
    <Krylov_space_dimension> 200 </Krylov_space_dimension>
    <NS_GM_max_iterations> 6 </NS_GM_max_iterations>
    <NS_GM_tolerance> 1e-2 </NS_GM_tolerance>
    <NS_CG_max_iterations> 400 </NS_CG_max_iterations>
    <NS_CG_tolerance> 1e-2 </NS_CG_tolerance>
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
  </LS>
  <Output type="Spatial">
    <Velocity> true </Velocity>
    <Pressure> true </Pressure>
  </Output>

  <!-- inlet + side faces: full vector (U,0,0) at every node, constant in time.
       Zero_out_perimeter=false is essential: the default would zero U on the shared edges. -->
  <Add_BC name="x0">
    <Type> Dirichlet </Type>
    <Time_dependence> General </Time_dependence>
    <Temporal_and_spatial_values_file_path> @CASE@/genbc_x0.dat </Temporal_and_spatial_values_file_path>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>
  <Add_BC name="y0">
    <Type> Dirichlet </Type>
    <Time_dependence> General </Time_dependence>
    <Temporal_and_spatial_values_file_path> @CASE@/genbc_y0.dat </Temporal_and_spatial_values_file_path>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>
  <Add_BC name="y1">
    <Type> Dirichlet </Type>
    <Time_dependence> General </Time_dependence>
    <Temporal_and_spatial_values_file_path> @CASE@/genbc_y1.dat </Temporal_and_spatial_values_file_path>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>
  <Add_BC name="z0">
    <Type> Dirichlet </Type>
    <Time_dependence> General </Time_dependence>
    <Temporal_and_spatial_values_file_path> @CASE@/genbc_z0.dat </Temporal_and_spatial_values_file_path>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>
  <Add_BC name="z1">
    <Type> Dirichlet </Type>
    <Time_dependence> General </Time_dependence>
    <Temporal_and_spatial_values_file_path> @CASE@/genbc_z1.dat </Temporal_and_spatial_values_file_path>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>
  <!-- outlet: RESISTANCE. It fixes the pressure level (a zero-traction outlet left the FSILS
       NS solve singular); the free stream stays exact for any uniform pressure level. -->
  <Add_BC name="x1">
    <Type> Neu </Type>
    <Time_dependence> Resistance </Time_dependence>
    <Value> 50.0 </Value>
  </Add_BC>
</Add_equation>

<Add_equation type="mesh">
  <Mesh_stiffness_exponent> 2.0 </Mesh_stiffness_exponent>

  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <Max_iterations> 1 </Max_iterations>
  <Tolerance> 0.1 </Tolerance>
  <Poisson_ratio> 0.30 </Poisson_ratio>
  <LS type="GMRES">
    <Max_iterations> 500 </Max_iterations>
    <Tolerance> 5e-3 </Tolerance>
    <Krylov_space_dimension> 300 </Krylov_space_dimension>
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
  </LS>
  <Output type="Spatial">
    <Displacement> true </Displacement>
  </Output>
  <!-- affine dilation prescribed on the six faces (one global file, mapped by GID) -->
  <Add_BC name="x0">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> @CASE@/displacement_allfaces.txt </Prescribed_displacement_file_path>
  </Add_BC>
  <Add_BC name="x1">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> @CASE@/displacement_allfaces.txt </Prescribed_displacement_file_path>
  </Add_BC>
  <Add_BC name="y0">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> @CASE@/displacement_allfaces.txt </Prescribed_displacement_file_path>
  </Add_BC>
  <Add_BC name="y1">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> @CASE@/displacement_allfaces.txt </Prescribed_displacement_file_path>
  </Add_BC>
  <Add_BC name="z0">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> @CASE@/displacement_allfaces.txt </Prescribed_displacement_file_path>
  </Add_BC>
  <Add_BC name="z1">
    <Type> Prescribed_displacement </Type>
    <Prescribed_displacement_file_path> @CASE@/displacement_allfaces.txt </Prescribed_displacement_file_path>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
