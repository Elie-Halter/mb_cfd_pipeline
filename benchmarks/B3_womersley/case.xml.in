<svMultiPhysicsFile version="1.0">

<!-- ============================================================
  B3 - WOMERSLEY FLOW (unsteady velocity, not WSS), template filled in by
  benchmarks/run_all.sh (@CASE@ = directory written by gen_case.py, @GRID@ = g1|g2|g3).
  RIGID tube R = 1 cm, L = 6 cm, alpha ~ 12.9 (aortic). p_in = 1333.2 sin(2 pi t) dyn/cm2
  (~1 mmHg, unsteady Neumann, 401 points / 64 Fourier modes), p_out = 0, no-slip wall.
  Exact solution: Womersley u_z(r,t) (the convective term vanishes identically; a uniform cap
  traction is the exact developed solution on the finite tube).
  ANALYTIC IC (ic_<grid>.vtu): without it the start-up transient lasts ~14 cycles.
  BACKFLOW = 0: the flow reverses at both caps every half cycle and the (non-linear) backflow
  stabilisation injects harmonics into the clean oscillating pressure BC; this laminar case
  (Re_delta ~ 96) is stable without it. rho_inf = 0.5 (less dissipative than 0.2).
============================================================ -->

<GeneralSimulationParameters>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> @NSTEPS@ </Number_of_time_steps>   <!-- N_CYCLES periods at dt = 5 ms -->
  <Time_step_size> 0.005 </Time_step_size>
  <Restart_file_name> results </Restart_file_name>
  <Increment_in_saving_restart_files> 100 </Increment_in_saving_restart_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>
  <Continue_previous_simulation> false </Continue_previous_simulation>
  <Simulation_initialization_file_path> @CASE@/ic_@GRID@.vtu </Simulation_initialization_file_path>
  <Save_averaged_results> false </Save_averaged_results>
  <Save_results_to_VTK_format> true </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> results </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 5 </Increment_in_saving_VTK_files>  <!-- 40 snapshots per cycle -->
  <Spectral_radius_of_infinite_time_step> 0.5 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>
  <Verbose> true </Verbose>
  <Warning> true </Warning>
  <Debug> false </Debug>
</GeneralSimulationParameters>

<Add_mesh name="tube">
  <Mesh_file_path> @CASE@/mesh_@GRID@/mesh-complete.mesh.vtu </Mesh_file_path>
  <Mesh_scale_factor> 0.1 </Mesh_scale_factor>   <!-- mm -> cm (pipeline convention) -->
  <Add_face name="wall">
    <Face_file_path> @CASE@/mesh_@GRID@/mesh-surfaces/wall.vtp </Face_file_path>
  </Add_face>
  <Add_face name="z0">
    <Face_file_path> @CASE@/mesh_@GRID@/mesh-surfaces/z0.vtp </Face_file_path>
  </Add_face>
  <Add_face name="z1">
    <Face_file_path> @CASE@/mesh_@GRID@/mesh-surfaces/z1.vtp </Face_file_path>
  </Add_face>
</Add_mesh>

<Add_equation type="fluid">
  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <Max_iterations> 10 </Max_iterations>
  <Tolerance> 1e-4 </Tolerance>

  <Backflow_stabilization_coefficient> 0.0 </Backflow_stabilization_coefficient>
  <Density> 1.06 </Density>
  <Viscosity model="Constant">
    <Value> 0.04 </Value>
  </Viscosity>
  <LS type="NS">
    <Max_iterations> 200 </Max_iterations>
    <Tolerance> 1e-4 </Tolerance>
    <Krylov_space_dimension> 200 </Krylov_space_dimension>
    <NS_GM_max_iterations> 6 </NS_GM_max_iterations>
    <NS_GM_tolerance> 1e-3 </NS_GM_tolerance>
    <NS_CG_max_iterations> 400 </NS_CG_max_iterations>
    <NS_CG_tolerance> 1e-3 </NS_CG_tolerance>
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
  </LS>
  <Output type="Spatial">
    <Velocity> true </Velocity>
    <Pressure> true </Pressure>
  </Output>

  <!-- rigid no-slip wall -->
  <Add_BC name="wall">
    <Type> Dirichlet </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0.0 </Value>
    <Profile> Flat </Profile>
  </Add_BC>
  <!-- oscillating pressure gradient: p_in = A sin(wt), p_out = 0 -->
  <Add_BC name="z0">
    <Type> Neumann </Type>
    <Time_dependence> Unsteady </Time_dependence>
    <Temporal_values_file_path> @CASE@/pressure_inlet.dat </Temporal_values_file_path>
  </Add_BC>
  <Add_BC name="z1">
    <Type> Neumann </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0.0 </Value>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
